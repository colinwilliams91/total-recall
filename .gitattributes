*.golden -text

# Byte-for-byte mirror contract: internal/hooks/scripts_test.go compares the
# hooks/ doc copies against the LF-only Go consts, and the installer writes the
# generated bytes verbatim (LF .bat hooks included). Without eol=lf a
# core.autocrlf checkout turns these CRLF on Windows and the mirror test fails.
hooks/*.sh text eol=lf
hooks/*.bat text eol=lf
